# =========================================================================
# HireSense AI - Environment Variables Template (.env.example)
# Copy this file to .env and configure values for your environment.
# NEVER commit the real .env file with actual credentials to version control.
# =========================================================================

# -------------------------------------------------------------------------
# Spring Boot & Database Configuration
# -------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DB_URL=jdbc:mysql://mysql:3306/hiresense_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=hiresense_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_ROOT_PASSWORD=YOUR_STRONG_MYSQL_ROOT_PASSWORD_HERE
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# -------------------------------------------------------------------------
# JWT & Security Configuration
# -------------------------------------------------------------------------
# Generate a 256-bit Base64-encoded secret key: openssl rand -base64 32
JWT_SECRET=YOUR_256_BIT_BASE64_SECRET_KEY_HERE
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# -------------------------------------------------------------------------
# Administrator Initial Account
# -------------------------------------------------------------------------
ADMIN_AUTO_CREATE=true
INITIAL_ADMIN_EMAIL=admin@yourinstitution.edu
INITIAL_ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE

# -------------------------------------------------------------------------
# AI Engine Configuration (Mock vs Google Gemini)
# -------------------------------------------------------------------------
# Options: 'mock' (offline deterministic mode) or 'gemini' (live cloud LLM)
AI_PROVIDER=mock
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# -------------------------------------------------------------------------
# Storage Configuration
# -------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCATION=storage/resumes

# -------------------------------------------------------------------------
# Google OAuth 2.0 (Authorization Code Flow)
# -------------------------------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials (Web Application)
# Authorized JavaScript Origin: http://localhost:5173
# Authorized Redirect URI: http://localhost:8080/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLOUD_WEB_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLOUD_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173/auth/callback
FRONTEND_LOGIN_URL=http://localhost:5173/login

# -------------------------------------------------------------------------
# Frontend Configuration (for React / Vite build)
# -------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1

